function loadStarterTemplates() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActive().getSheetByName(SHEETS.TEMPLATES);
  if (!sheet) { ui.alert('Сначала выполните «1. Создать структуру таблицы».'); return; }
  if (sheet.getLastRow() > 1) {
    ui.alert('На листе «' + SHEETS.TEMPLATES + '» уже есть шаблоны. Чтобы ничего не затереть, загрузка работает только в пустой лист.');
    return;
  }
  sheet.getRange(2, 1, STARTER_TEMPLATES.length, HEADERS.TEMPLATES.length).setValues(STARTER_TEMPLATES);
  sheet.getRange(2, 6, STARTER_TEMPLATES.length, 1).setWrap(true);
  writeLog_('владелец таблицы', 'Загружены стартовые шаблоны', STARTER_TEMPLATES.length + ' шт.');
  ui.alert('Загружено шаблонов: ' + STARTER_TEMPLATES.length + '.');
}
